{
  "version": 2,
  "builds": [
    {
      "src": "landing/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/download/extension",
      "dest": "/landing/turbo-download-manager-extension.zip"
    },
    {
      "src": "/download/app",
      "dest": "/landing/turbo-download-manager-windows-portable.zip"
    },
    {
      "src": "/turbo-download-manager-extension.zip",
      "dest": "/landing/turbo-download-manager-extension.zip"
    },
    {
      "src": "/turbo-download-manager-windows-portable.zip",
      "dest": "/landing/turbo-download-manager-windows-portable.zip"
    },
    {
      "src": "/(.*)",
      "dest": "/landing/$1"
    }
  ]
}
